#!/usr/bin/env bash
# fzf-mute-video:summary=去掉视频的声音（支持一次处理多个文件）。
set -euo pipefail

script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
source "$script_dir/fzf-fftools-lib"

require_tools ffmpeg || exit 1

mapfile -t videos < <(fftools_input_videos "$@")
(( ${#videos[@]} == 0 )) && exit 0

total=${#videos[@]}
ok=0
fail=0
for v in "${videos[@]}"; do
    base="${v%.*}"; ext="${v##*.}"
    [[ "$base" == "$v" ]] && { base="$v"; ext=""; }
    output="${base}_muted${ext:+.$ext}"
    index=1
    while [[ -e "$output" ]]; do
        output="${base}_muted-${index}${ext:+.$ext}"
        ((++index))
    done
    printf '%s → %s ... ' "$v" "$output"
    if ffmpeg -v error -i "$v" -c copy -an -y "$output"; then
        ((++ok))
        echo "✅"
    else
        ((++fail))
        echo "❌"
    fi
done
printf '完成: 成功 %d, 失败 %d\n' "$ok" "$fail"
