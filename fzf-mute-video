#!/usr/bin/env bash
# fzf-mute-video:summary=Remove audio track from video file(s) via fzf (batch).
set -euo pipefail

script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
source "$script_dir/fzf-fftools-lib"

require_tools ffmpeg || exit 1

if [[ $# -gt 0 ]]; then
    videos=("$@")
else
    require_tools fzf fd || exit 1
    mapfile -t videos < <(pick_videos)
fi
(( ${#videos[@]} == 0 )) && exit 0

total=${#videos[@]}
ok=0
fail=0
for v in "${videos[@]}"; do
    output="${v%.*}_muted.${v##*.}"
    printf '%s → %s ... ' "$v" "$output"
    if ffmpeg -v error -i "$v" -c copy -an -y "$output" 2>/dev/null; then
        ((++ok))
        echo "✅"
    else
        ((++fail))
        echo "❌"
    fi
done
printf '完成: 成功 %d, 失败 %d\n' "$ok" "$fail"
