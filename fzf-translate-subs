#!/usr/bin/env bash
# fzf-translate-subs:summary=用本地 AI（Ollama）翻译已有的字幕文件。
set -euo pipefail

script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
source "$script_dir/fzf-fftools-lib"

require_tools fzf fd ollama || exit 1

# 翻译引擎在 fzf-fftools-lib（与 fzf-generate-subs 共用）
FZF_TRANSLATE_MODEL=${FZF_TRANSLATE_MODEL:-translategemma:12b}
export FZF_TRANSLATE_MODEL

files=$(fd --type f --hidden --follow --ignore-case \
    --extension srt --extension vtt --extension lrc --extension txt \
    --exclude .git --exclude node_modules . 2>/dev/null | \
    fzf "${FZF_BASE[@]}" "${FZF_MULTI_BASE[@]}" \
        --header '选择已有字幕 · Tab 多选 · Ctrl-A 全选' \
        --preview "$PVID {}") || exit 0
[[ -n "$files" ]] || exit 0
mapfile -t subtitle_files <<< "$files"

target=$(printf '%s\n' \
    "zh  简体中文" "en  English" "ja  日本語" "ko  한국어" \
    "fr  Français" "de  Deutsch" "es  Español" "custom  自定义" \
| fzf "${FZF_BASE[@]}" --height 35% --header '翻译目标语言') || exit 0

case "$target" in
    custom*) read -r -p '目标语言: ' target_lang || true; target_lang="${target_lang:-zh}" ;;
    *) target_lang=${target%% *} ;;
esac

bilingual=false
if fftools_confirm '双语模式（原文+译文）？[y/N]' no; then
    bilingual=true
fi

translate_file() {
    local input="$1" output="$2" language="$3" keep_original="$4"
    local extension=${input##*.}

    case "$extension" in
        srt|vtt) translate_timed "$input" "$output" "$language" "$keep_original" ;;
        lrc)     translate_lrc "$input" "$output" "$language" "$keep_original" ;;
        txt)     translate_txt "$input" "$output" "$language" ;;
        *)       return 2 ;;
    esac
}

success=0
for subtitle in "${subtitle_files[@]}"; do
    extension=${subtitle##*.}
    directory=$(dirname -- "$subtitle")
    stem=$(basename -- "${subtitle%.*}")
    output="$directory/$stem.$target_lang.$extension"
    [[ -e "$output" ]] && output="$directory/$stem.$target_lang.translated.$extension"

    printf '\n翻译: %s\n' "$subtitle"
    temporary_output=$(mktemp "${TMPDIR:-/tmp}/fzf-subtrans.XXXXXX") || {
        printf '✗ 无法创建临时文件，跳过: %s\n' "$subtitle" >&2
        continue
    }
    if ! translate_file "$subtitle" "$temporary_output" "$target_lang" "$bilingual"; then
        rm -f -- "$temporary_output"
        printf '✗ 翻译失败: %s\n' "$subtitle" >&2
        continue
    fi
    if [[ ! -s "$temporary_output" ]]; then
        rm -f -- "$temporary_output"
        printf '✗ 翻译失败: %s\n' "$subtitle" >&2
        continue
    fi
    mv -f -- "$temporary_output" "$output"
    ((++success))
    printf '✓ 已生成: %s\n' "$output"
done

printf '\n翻译完成: %d/%d 成功\n' "$success" "${#subtitle_files[@]}"
