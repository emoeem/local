#!/usr/bin/env bash
# fzf-translate-subs: Translate existing SRT/VTT/LRC/TXT subtitles with Ollama.
set -euo pipefail

script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
source "$script_dir/fzf-fftools-lib"

require_tools fzf fd ollama || exit 1

TRANSLATE_MODEL=${FZF_TRANSLATE_MODEL:-translategemma:12b}
BATCH_SIZE=${FZF_TRANSLATE_BATCH:-20}

files=$(fd --type f --hidden --follow --ignore-case \
    --extension srt --extension vtt --extension lrc --extension txt \
    --exclude .git --exclude node_modules . 2>/dev/null | \
    fzf "${FZF_BASE[@]}" "${FZF_MULTI_BASE[@]}" \
        --header '选择已有字幕 · Tab 多选 · Ctrl-A 全选' \
        --preview "$PVID {}") || exit 0
[[ -n "$files" ]] || exit 0
mapfile -t subtitle_files <<< "$files"

target=$(printf '%s\n' \
    "zh  简体中文" "en  English" "ja  日本語" "ko  한국어" \
    "fr  Français" "de  Deutsch" "es  Español" "custom  自定义" \
| fzf "${FZF_BASE[@]}" --height 35% --header '翻译目标语言') || exit 0

case "$target" in
    custom*) read -r -p '目标语言: ' target_lang || true; target_lang="${target_lang:-zh}" ;;
    *) target_lang=${target%% *} ;;
esac

bilingual=false
if fftools_confirm '双语模式（原文+译文）？[y/N]' no; then
    bilingual=true
fi

lang_name() {
    case "$1" in
        zh) printf '简体中文' ;; en) printf 'English' ;; ja) printf '日本語' ;;
        ko) printf '한국어' ;; fr) printf 'Français' ;; de) printf 'Deutsch' ;;
        es) printf 'Español' ;; *) printf '%s' "$1" ;;
    esac
}

# 翻译单条文本；preserve=1 时保留换行(用于 TXT)，默认折叠为单行(字幕)
translate_text() {
    local source_text="$1" language="$2" preserve="${3:-0}" result
    result=$(ollama run "$TRANSLATE_MODEL" \
        "Translate the following subtitle text to $(lang_name "$language"). Output ONLY the translation, nothing else. Preserve original line breaks.

$source_text" </dev/null) || return 1
    [[ -n "$result" ]] || return 1
    if [[ "$preserve" == 1 ]]; then
        result=$(printf '%s\n' "$result" | awk 'NF { if (!s) s=NR; e=NR } { l[NR]=$0 } END { for (i=s;i<=e;i++) print l[i] }')
    else
        result=$(printf '%s' "$result" | tr '\n' ' ' | sed 's/[[:space:]][[:space:]]*/ /g; s/^ //; s/ $//')
    fi
    [[ -n "$result" ]] || return 1
    printf '%s\n' "$result"
}

# 批量翻译：把多条字幕编号后合并成一次请求；解析或条数校验失败返回 1，
# 由调用方逐条回退(translate_text)保证正确性
# 用法: batch_translate_into <输出数组名> <语言> <文本...>
batch_translate_into() {
    local -n __out=$1
    local language="$2"
    shift 2
    local -a texts=("$@") parsed=()
    local prompt blocks='' result i n cur=0 idx line t
    (( ${#texts[@]} )) || { __out=(); return 0; }
    for i in "${!texts[@]}"; do
        printf -v blocks '%s[%d] %s\n' "$blocks" "$((i+1))" "${texts[i]}"
    done
    prompt="You are a subtitle translator. Translate each numbered line to $(lang_name "$language"). Output ONLY the translations, one per line, each prefixed with its [number]. Do not add explanations, do not merge or reorder lines.

$blocks"
    result=$(ollama run "$TRANSLATE_MODEL" "$prompt" </dev/null) || return 1
    [[ -n "$result" ]] || return 1
    while IFS= read -r line; do
        if [[ "$line" =~ ^\[([0-9]+)\][[:space:]]?(.*)$ ]]; then
            idx=$((10#${BASH_REMATCH[1]}))
            if (( idx >= 1 && idx <= ${#texts[@]} )); then
                cur=$idx
                parsed[cur]=${BASH_REMATCH[2]}
            else
                cur=0
            fi
            continue
        fi
        if (( cur >= 1 )); then
            parsed[cur]+=" $line"
        fi
    done <<< "$result"
    __out=()
    for i in "${!texts[@]}"; do
        n=$((i+1))
        t=${parsed[n]:-}
        [[ -n "$t" ]] || return 1
        t=${t#"${t%%[![:space:]]*}"}
        t=${t%"${t##*[![:space:]]}"}
        __out+=("$t")
    done
    return 0
}

# 把缓存的 SRT/VTT 字幕块批量翻译并写出；失败时逐条回退
# 依赖调用方(translate_timed)动态作用域中的 index/total/label/cue_times/cue_texts
flush_timed() {
    local output="$1" keep="$2" ext="$3" language="$4"
    local -a translations=()
    local i ok=0 one
    (( ${#cue_texts[@]} )) || return 0
    if batch_translate_into translations "$language" "${cue_texts[@]}"; then
        if (( ${#translations[@]} == ${#cue_texts[@]} )); then
            ok=1
        fi
    fi
    if (( ok == 0 )); then
        translations=()
        for one in "${cue_texts[@]}"; do
            one=$(translate_text "$one" "$language") || { cue_times=(); cue_texts=(); return 1; }
            translations+=("$one")
        done
    fi
    for i in "${!cue_texts[@]}"; do
        ((++index))
        if [[ "$ext" == vtt ]]; then
            printf '%s\n' "${cue_times[i]}" >> "$output"
        else
            printf '%d\n%s\n' "$index" "${cue_times[i]}" >> "$output"
        fi
        if [[ "$keep" == 1 ]]; then
            printf '%s\n' "${cue_texts[i]}" >> "$output"
        fi
        printf '%s\n\n' "${translations[i]}" >> "$output"
        fftools_progress "$index" "$total" "$label"
    done
    cue_times=(); cue_texts=()
    return 0
}

# 把缓存的 LRC 歌词行批量翻译并写出；失败时逐条回退
# 依赖调用方(translate_lrc)动态作用域中的 index/total/label/cue_tags/cue_texts
flush_lrc() {
    local output="$1" keep="$2" language="$3"
    local -a translations=()
    local i ok=0 one
    (( ${#cue_texts[@]} )) || return 0
    if batch_translate_into translations "$language" "${cue_texts[@]}"; then
        if (( ${#translations[@]} == ${#cue_texts[@]} )); then
            ok=1
        fi
    fi
    if (( ok == 0 )); then
        translations=()
        for one in "${cue_texts[@]}"; do
            one=$(translate_text "$one" "$language") || { cue_tags=(); cue_texts=(); return 1; }
            translations+=("$one")
        done
    fi
    for i in "${!cue_texts[@]}"; do
        ((++index))
        if [[ "$keep" == 1 ]]; then
            printf '%s%s\n' "${cue_tags[i]}" "${cue_texts[i]}" >> "$output"
        fi
        printf '%s%s\n' "${cue_tags[i]}" "${translations[i]}" >> "$output"
        fftools_progress "$index" "$total" "$label"
    done
    cue_tags=(); cue_texts=()
    return 0
}

translate_timed() {
    local input="$1" output="$2" language="$3" keep_original="$4"
    local timestamp='' text='' line
    local index=0 total label extension keep=0
    local -a cue_times=() cue_texts=()
    if [[ "$keep_original" == true ]]; then keep=1; fi
    extension=${input##*.}
    total=$(awk '/^([0-9][0-9]:)?[0-9][0-9]:[0-9][0-9][,.][0-9]/{count++} END{print count + 0}' "$input")
    label=$(basename -- "$input")
    : > "$output"

    while IFS= read -r line || [[ -n "$line" ]]; do
        line=${line%$'\r'}
        line=${line#$'\xEF\xBB\xBF'}
        if [[ -z "$line" ]]; then
            if [[ -n "$text" ]]; then
                cue_times+=("$timestamp")
                cue_texts+=("$text")
                timestamp=''; text=''
                if (( ${#cue_texts[@]} >= BATCH_SIZE )); then
                    flush_timed "$output" "$keep" "$extension" "$language" || return 1
                fi
            fi
            continue
        fi
        if [[ "$line" == WEBVTT* ]]; then
            flush_timed "$output" "$keep" "$extension" "$language" || return 1
            printf '%s\n\n' "$line" >> "$output"
            continue
        fi
        if [[ "$line" =~ ^([0-9]{1,2}:)?[0-9]{2}:[0-9]{2}[,.][0-9] ]]; then
            timestamp="$line"
            continue
        fi
        if [[ "$line" =~ ^[0-9]+$ && -z "$timestamp" ]]; then
            continue
        fi
        text="${text:+$text
}$line"
    done < "$input"

    if [[ -n "$text" ]]; then
        cue_times+=("$timestamp")
        cue_texts+=("$text")
    fi
    flush_timed "$output" "$keep" "$extension" "$language" || return 1
    return 0
}

translate_lrc() {
    local input="$1" output="$2" language="$3" keep_original="$4"
    local line tag text
    local index=0 total label keep=0
    local -a cue_tags=() cue_texts=()
    if [[ "$keep_original" == true ]]; then keep=1; fi
    total=$(awk '/^\[[0-9][0-9]:[0-9][0-9]\.[0-9][0-9][0-9]?\].+/{count++} END{print count + 0}' "$input")
    label=$(basename -- "$input")
    : > "$output"
    while IFS= read -r line || [[ -n "$line" ]]; do
        line=${line%$'\r'}
        line=${line#$'\xEF\xBB\xBF'}
        if [[ "$line" =~ ^(\[[0-9][0-9]:[0-9][0-9]\.[0-9]{2,3}\])(.*)$ ]]; then
            tag=${BASH_REMATCH[1]}; text=${BASH_REMATCH[2]}
            if [[ -z "$text" ]]; then
                printf '%s\n' "$line" >> "$output"
                continue
            fi
            cue_tags+=("$tag")
            cue_texts+=("$text")
            if (( ${#cue_texts[@]} >= BATCH_SIZE )); then
                flush_lrc "$output" "$keep" "$language" || return 1
            fi
            continue
        fi
        flush_lrc "$output" "$keep" "$language" || return 1
        printf '%s\n' "$line" >> "$output"
    done < "$input"
    flush_lrc "$output" "$keep" "$language" || return 1
    return 0
}

# TXT 按段落分块翻译，保留换行段落结构，避免整文件单次请求
translate_txt() {
    local input="$1" output="$2" language="$3"
    local chunk='' line
    : > "$output"
    while IFS= read -r line || [[ -n "$line" ]]; do
        line=${line%$'\r'}
        line=${line#$'\xEF\xBB\xBF'}
        if [[ -z "$line" && ${#chunk} -ge 1200 ]]; then
            translate_text "$chunk" "$language" 1 >> "$output" || return 1
            printf '\n' >> "$output"
            chunk=''
            continue
        fi
        chunk+="$line"$'\n'
        if (( ${#chunk} > 6000 )); then
            translate_text "$chunk" "$language" 1 >> "$output" || return 1
            printf '\n' >> "$output"
            chunk=''
        fi
    done < "$input"
    if [[ -n "$chunk" ]]; then
        translate_text "$chunk" "$language" 1 >> "$output" || return 1
    fi
    return 0
}

translate_file() {
    local input="$1" output="$2" language="$3" keep_original="$4"
    local extension=${input##*.}

    case "$extension" in
        srt|vtt) translate_timed "$input" "$output" "$language" "$keep_original" ;;
        lrc)     translate_lrc "$input" "$output" "$language" "$keep_original" ;;
        txt)     translate_txt "$input" "$output" "$language" ;;
        *)       return 2 ;;
    esac
}

success=0
for subtitle in "${subtitle_files[@]}"; do
    extension=${subtitle##*.}
    directory=$(dirname -- "$subtitle")
    stem=$(basename -- "${subtitle%.*}")
    output="$directory/$stem.$target_lang.$extension"
    [[ -e "$output" ]] && output="$directory/$stem.$target_lang.translated.$extension"

    printf '\n翻译: %s\n' "$subtitle"
    temporary_output=$(mktemp "${output}.tmp.XXXXXX")
    if ! translate_file "$subtitle" "$temporary_output" "$target_lang" "$bilingual"; then
        rm -f -- "$temporary_output"
        printf '✗ 翻译失败: %s\n' "$subtitle" >&2
        continue
    fi
    if [[ ! -s "$temporary_output" ]]; then
        rm -f -- "$temporary_output"
        printf '✗ 翻译失败: %s\n' "$subtitle" >&2
        continue
    fi
    mv -f -- "$temporary_output" "$output"
    ((++success))
    printf '✓ 已生成: %s\n' "$output"
done

printf '\n翻译完成: %d/%d 成功\n' "$success" "${#subtitle_files[@]}"
