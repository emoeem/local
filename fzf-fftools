#!/usr/bin/env bash
# fzf-fftools: FFmpeg 工具箱主循环
set -u

script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
source "$script_dir/fzf-fftools-lib"

require_tools fzf || exit 1

if [[ "${1:-}" == "--yazi" ]]; then
    shift
    require_tools yazi || exit 1
    exec yazi "${1:-.}"
fi

case "${1:-}" in
    doctor) fftools_doctor; exit ;;
    analyze) shift; [[ $# -gt 0 ]] || { printf '用法: fzf-fftools analyze <文件>\n' >&2; exit 2; }; fftools_analyze "$1"; exit ;;
    cache) shift; fftools_cache "${1:-status}"; exit ;;
esac

OPS=(
    "1. 一键预设      fzf-ffmpeg-preset       选现成方案直接转码"
    "2. 命令构建器    fzf-ffmpeg-builder      手动拼 ffmpeg 命令"
    "3. 裁剪片段      fzf-trim-video          剪掉一段，快速或精确"
    "4. 抽流          fzf-extract-streams     抽出视频/音轨/字幕/附件"
    "5. 混流          fzf-mux-media           把画面声音字幕装进一个文件"
    "6. 批量图片      fzf-image-batch         批量转换格式/缩放尺寸"
    "7. 移除音频      fzf-mute-video          去掉声音"
    "8. 合并音视频    fzf-merge-av            自动配对视频+音频并合并"
    "9. 拼接视频      fzf-concat-video        多个视频按顺序接成一个"
    "A. 烧录字幕      fzf-burn-subs           把字幕印进画面"
    "B. 视频转GIF     fzf-video-to-gif        做成动图"
    "C. 变速处理      fzf-speed-video         加速或减速"
    "D. 批量转码      fzf-ffmpeg-batch        一次处理多个视频"
    "E. 色彩管理      fzf-ffmpeg-color        HDR/SDR 互转"
    "F. 媒体转换      fzf-convert-media       换视频/音频/图片格式"
    "G. 质量评测      fzf-quality-eval        压缩前后画质打分"
    "H. 媒体验证      fzf-validate-media      检查文件是否损坏"
    "I. 添加水印      fzf-add-watermark       加文字或图片水印"
    "J. 媒体浏览      __browse_media          看图/视频帧/音频封面"
    "K. Yazi工作台    __yazi_media            文件管理器"
    "L. AI生成字幕    fzf-generate-subs       Whisper自动生成字幕"
    "M. AI翻译字幕    fzf-translate-subs      Ollama翻译已有字幕"
    "N. 音频工具      fzf-audio-tools         标准化音量、转码、封面"
    "O. 媒体分析      __analyze_media         查看编码、HDR、音轨"
    "P. 环境诊断      __doctor                检查依赖与编码器"
    "Q. 预览缓存      __cache                 清理预览缓存"
    "R. 编码队列      __queue                 排队处理，可跳过、可重试"
)

while true; do
    SEL=$(printf '%s\n' "${OPS[@]}" | fzf "${FZF_BASE[@]}" --height 70% --header 'FFmpeg 工具箱 (q 或 Esc 退出)' \
        --bind 'q:abort' --bind 'esc:abort' \
        --preview 'printf "%s - %s\n" "{2}" "{4}"' --preview-window 'bottom:1:wrap')
    [[ -z "$SEL" ]] && break

    CMD=$(echo "$SEL" | awk '{print $3}')
    if [[ "$CMD" == "__browse_media" ]]; then
        media=$(pick_media) || continue
        clear
        FZF_PREVIEW_COLUMNS="${COLUMNS:-80}" FZF_PREVIEW_LINES="${LINES:-30}" "$PVID" "$media"
        echo
        read -r -p "按 Enter 返回菜单..."
    elif [[ "$CMD" == "__yazi_media" ]]; then
        if command -v yazi >/dev/null 2>&1; then
            yazi .
        else
            echo "未找到: yazi"
            sleep 1
        fi
    elif [[ "$CMD" == "__analyze_media" ]]; then
        media=$(pick_media) || continue
        clear
        fftools_analyze "$media" | less -R
    elif [[ "$CMD" == "__doctor" ]]; then
        clear
        fftools_doctor
    elif [[ "$CMD" == "__cache" ]]; then
        choice=$(printf '%s\n' 'status' 'prune (清理30天前缓存)' 'clear (清空全部缓存)' | fzf --height 30% --header '预览缓存') || continue
        fftools_cache "${choice%% *}"
    elif [[ "$CMD" == "__queue" ]]; then
        "$script_dir/fzf-ffmpeg-batch" --queue
        echo
        read -r -p "按 Enter 返回菜单..."
    elif [[ -x "$script_dir/$CMD" ]]; then
        "$script_dir/$CMD"
        echo
        read -r -p "按 Enter 返回菜单..."
    else
        echo "未找到: $CMD"
        sleep 1
    fi
done
