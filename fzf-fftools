#!/usr/bin/env bash
# fzf-fftools: FFmpeg 工具箱主循环
set -u

script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
source "$script_dir/fzf-fftools-lib"

if [[ "${1:-}" == "--yazi" ]]; then
    shift
    require_tools yazi || exit 1
    exec yazi "${1:-.}"
fi

case "${1:-}" in
    doctor) fftools_doctor; exit ;;
    analyze) shift; [[ $# -gt 0 ]] || { printf '用法: fzf-fftools analyze <文件>\n' >&2; exit 2; }; fftools_analyze "$1"; exit ;;
    cache) shift; fftools_cache "${1:-status}"; exit ;;
esac

OPS=(
    "1. 命令构建器    fzf-ffmpeg-builder     编码器+滤镜+硬件加速"
    "2. 快速预设      fzf-ffmpeg-preset      一键硬件/软件方案"
    "3. 裁剪片段      fzf-trim-video         按时间裁剪"
    "4. 提取音频      fzf-extract-audio      从视频提取音频"
    "5. 移除音频      fzf-mute-video         删除音轨"
    "6. 合并音视频    fzf-merge-av           mkv 封装"
    "7. 拼接视频      fzf-concat-video       合并多片段"
    "8. 烧录字幕      fzf-burn-subs          嵌入字幕"
    "9. 视频转GIF     fzf-video-to-gif       生成动图"
    "A. 变速处理      fzf-speed-video        加速/减速"
    "B. 批量转码      fzf-ffmpeg-batch       批量处理"
    "C. 色彩管理      fzf-ffmpeg-color       HDR/SDR/色域"
    "D. 媒体转换      fzf-convert-media      视频/音频/图片格式"
    "E. 媒体验证      fzf-validate-media     检查文件完整性"
    "F. 添加水印      fzf-add-watermark      文字/图片水印"
    "G. 媒体浏览      __browse_media         图片/视频帧/音频封面"
    "H. Yazi工作台    __yazi_media           高清预览并用 F f 处理媒体"
    "I. AI字幕工具    fzf-ai-subtitles       Whisper生成或直接AI翻译已有字幕"
    "J. 字幕工具      fzf-subtitles          抽取、封装、烧录字幕"
    "K. 音频工具      fzf-audio-tools        标准化、转码、封面"
    "L. 媒体分析      __analyze_media        编码、HDR、音轨、字幕"
    "M. 环境诊断      __doctor               检查依赖与编码器"
    "N. 预览缓存      __cache                状态、清理、过期裁剪"
)

while true; do
    SEL=$(printf '%s\n' "${OPS[@]}" | fzf "${FZF_BASE[@]}" --height 70% --header 'FFmpeg 工具箱 (q 或 Esc 退出)' \
        --bind 'q:abort' --bind 'esc:abort' \
        --preview 'printf "%s - %s\n" "{2}" "{4}"' --preview-window 'bottom:1:wrap')
    [[ -z "$SEL" ]] && break

    CMD=$(echo "$SEL" | awk '{print $3}')
    if [[ "$CMD" == "__browse_media" ]]; then
        media=$(pick_media) || continue
        clear
        FZF_PREVIEW_COLUMNS="${COLUMNS:-80}" FZF_PREVIEW_LINES="${LINES:-30}" "$PVID" "$media"
        echo
        read -r -p "按 Enter 返回菜单..."
    elif [[ "$CMD" == "__yazi_media" ]]; then
        if command -v yazi >/dev/null 2>&1; then
            yazi .
        else
            echo "未找到: yazi"
            sleep 1
        fi
    elif [[ "$CMD" == "__analyze_media" ]]; then
        media=$(pick_media) || continue
        clear
        fftools_analyze "$media" | less -R
    elif [[ "$CMD" == "__doctor" ]]; then
        clear
        fftools_doctor
    elif [[ "$CMD" == "__cache" ]]; then
        choice=$(printf '%s\n' 'status' 'prune (清理30天前缓存)' 'clear (清空全部缓存)' | fzf --height 30% --header '预览缓存') || continue
        fftools_cache "${choice%% *}"
    elif command -v "$CMD" &>/dev/null; then
        "$CMD"
        echo
        read -r -p "按 Enter 返回菜单..."
    else
        echo "未找到: $CMD"
        sleep 1
    fi
done
