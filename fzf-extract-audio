#!/usr/bin/env bash
# fzf-extract-audio:summary=把视频里的声音单独抽出来，存成音频文件。
set -euo pipefail

script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
source "$script_dir/fzf-fftools-lib"

require_tools ffmpeg || exit 1

video=$(fftools_input_video "$@") || exit 0
[[ -z "$video" ]] && exit 0

fmt=$(printf 'm4a (AAC, 通用)\nmp3\nopus (高效)\nwav (无损)\nogg' \
    | fzf "${FZF_BASE[@]}" --height 30% --header '选择输出格式') || exit 0
[[ -z "$fmt" ]] && exit 0
fmt_key="${fmt%% *}"

output=$(fftools_output_prompt "$video" "${video%.*}.${fmt_key}")

ac_str=$(audio_codec_args "$fmt_key") || { echo "未知格式: $fmt_key" >&2; exit 1; }
read -r -a ac <<< "$ac_str"

fftools_run ffmpeg -i "$video" -vn "${ac[@]}" -y "$output"
