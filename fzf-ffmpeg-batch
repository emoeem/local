#!/usr/bin/env bash
# fzf-ffmpeg-batch:summary=批量转码：一次处理多个视频，自动选编码器和硬件加速。
set -euo pipefail

script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
source "$script_dir/fzf-fftools-lib"

require_tools ffmpeg ffprobe fzf || exit 1

if (( $# > 0 )); then
    mapfile -t files < <(printf '%s\n' "$@")
else
    require_tools fd || exit 1
    mapfile -t files < <(pick_files)
fi
(( ${#files[@]} > 0 )) || exit 0

venc=$(fftools_pick_encoder) || exit 0
[[ -n "$venc" ]] || exit 0

# 编码器默认参数（预设 + 质量，从库里取）
fftools_encoder_setup "$venc"
encode_args=("${ENCODE_ARGS[@]}")
pix_value=$PIX_VALUE

# 硬件解码（可选）
hw=$(fftools_choose_hwaccel) || true
decode_args=()
[[ -n "$hw" ]] && decode_args=(-hwaccel "$hw")

printf '输出目录 [%s/batch_out]: ' "$(pwd)"
read -r dir || true
[[ -z "$dir" ]] && dir="${PWD}/batch_out"
mkdir -p -- "$dir"

total=${#files[@]}
ok=0
fail=0
start_sec=$SECONDS
for f in "${files[@]}"; do
    name=$(basename -- "$f")
    # 不同目录同名文件追加序号，避免 -y 静默覆盖
    output="${dir}/${name%.*}_${venc}.mp4"
    if [[ -e "$output" ]]; then
        index=1
        while [[ -e "${dir}/${name%.*}_${venc}-${index}.mp4" ]]; do
            ((++index))
        done
        output="${dir}/${name%.*}_${venc}-${index}.mp4"
    fi
    count=$((ok + fail + 1))

    # HDR 检测：8-bit 编码器自动切到 10-bit，避免色偏
    pix_current=$pix_value
    if detect_hdr "$f"; then
        case "$venc" in
            libx264)    pix_current=yuv420p10le ;;
            h264_nvenc) pix_current=p010le ;;
        esac
        printf '⚠️  [%d/%d] %s — HDR 视频，使用 10-bit 编码 (%s)\n' "$count" "$total" "$name" "$pix_current"
    fi

    printf '[%d/%d] %s\n' "$count" "$total" "$name"
    args=(ffmpeg "${decode_args[@]}" -i "$f" -c:v "$venc" "${encode_args[@]}")
    [[ -n "$pix_current" ]] && args+=(-pix_fmt "$pix_current")
    args+=(-c:a aac -b:a 128k -y "$output")
    if fftools_run_live "${args[@]}"; then
        ((++ok))
    else
        ((++fail))
        printf '❌ %s — 转码失败\n' "$name"
    fi
done

elapsed=$((SECONDS - start_sec))
printf '完成: 成功 %d, 失败 %d → %s（用时 %d 秒）\n' "$ok" "$fail" "$dir" "$elapsed"
fftools_log "batch: ok=$ok fail=$fail dir=$dir elapsed=${elapsed}s"
