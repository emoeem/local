# ── 质量评测滤镜片段（源自 3FUI 质量评测工具）────────
# 用法: fftools_metric_filter <psnr|ssim|xpsnr|vmaf> <统计文件>
# 调用方需自行拼接 [dist]/[ref] 预处理滤镜
fftools_metric_filter() {
    local metric="$1" stats="$2"
    # 统计/日志路径需按滤镜参数规则转义，否则路径中的 : ' , 会破坏 filtergraph
    stats=${stats//\\/\\\\}
    stats=${stats//:/\\:}
    stats=${stats//\'/\\\'}
    stats=${stats//,/\\,}
    case "$metric" in
        psnr)  printf '[dist][ref]psnr=eof_action=endall:stats_file=%s' "$stats" ;;
        ssim)  printf '[dist][ref]ssim=eof_action=endall:stats_file=%s' "$stats" ;;
        xpsnr) printf '[ref][dist]xpsnr=eof_action=endall:stats_file=%s' "$stats" ;;
        vmaf)  local vmaf_args="pool=${FZF_VMAF_POOL:-mean}"
               [[ -n "${FZF_VMAF_MODEL:-}" ]] && vmaf_args="model=$(escape_subtitle_path "$FZF_VMAF_MODEL"):$vmaf_args"
               printf '[dist][ref]libvmaf=eof_action=endall:ts_sync_mode=nearest:log_fmt=json:log_path=%s:n_threads=%s:%s' \
                    "$stats" "${FZF_VMAF_THREADS:-0}" "$vmaf_args" ;;
    esac
}

# ── 降噪滤镜（源自 3FUI 滤镜系统）────────────────────
# 用法: fftools_denoise <hqdn3d|nlmeans|atadenoise|bm3d> <轻|中|强>
fftools_denoise() {
    local method="${1:-hqdn3d}" strength="${2:-中}"
    case "$method:$strength" in
        hqdn3d:轻)     printf 'hqdn3d=1.5:1.5:3:3' ;;
        hqdn3d:强)     printf 'hqdn3d=4:3:6:4.5' ;;
        hqdn3d:*)      printf 'hqdn3d=3:2:5:4' ;;
        nlmeans:轻)    printf 'nlmeans=s=1:p=1:pc=1:r=3' ;;
        nlmeans:强)    printf 'nlmeans=s=5:p=5:pc=7:r=7' ;;
        nlmeans:*)     printf 'nlmeans=s=3:p=3:pc=5:r=5' ;;
        atadenoise:轻) printf 'atadenoise=0a=1:0b=1:1a=1:1b=1' ;;
        atadenoise:强) printf 'atadenoise=0a=5:0b=5:1a=5:1b=5' ;;
        atadenoise:*)  printf 'atadenoise=0a=3:0b=3:1a=3:1b=3' ;;
        bm3d:轻)       printf 'bm3d=sigma=1:block=4:bstep=2:group=1' ;;
        bm3d:强)       printf 'bm3d=sigma=5:block=8:bstep=4:group=2' ;;
        bm3d:*)        printf 'bm3d=sigma=3:block=8:bstep=4:group=1' ;;
    esac
}

# ── 锐化滤镜（源自 3FUI 滤镜系统）────────────────────
# 用法: fftools_sharpen <unsharp|cas> <轻|中|强>
fftools_sharpen() {
    local method="${1:-unsharp}" strength="${2:-中}"
    case "$method:$strength" in
        cas:轻)     printf 'cas=strength=0.2' ;;
        cas:强)     printf 'cas=strength=0.8' ;;
        cas:*)      printf 'cas=strength=0.5' ;;
        unsharp:轻) printf 'unsharp=5:5:0.3' ;;
        unsharp:强) printf 'unsharp=5:5:1.0' ;;
        unsharp:*)  printf 'unsharp=5:5:0.6' ;;
    esac
}

# ── 智能补帧（源自 3FUI 插帧滤镜）────────────────────
# 用法: fftools_interpolate <目标帧率> <mci|mcn>
fftools_interpolate() {
    local fps="${1:-60}" mode="${2:-mci}"
    printf 'minterpolate=fps=%s:mi_mode=%s:me_mode=bidir:mc_mode=aobmc' "$fps" "$mode"
}

# ── 动态模糊（源自 3FUI 动态模糊滤镜）────────────────
# 用法: fftools_tmix <混合帧数 2~4>
fftools_tmix() {
    printf 'tmix=frames=%s' "${1:-3}"
}

# ── 胶片颗粒（源自 3FUI 胶片颗粒滤镜）────────────────
# 用法: fftools_grain <轻|中|强>
fftools_grain() {
    case "${1:-中}" in
        轻) printf 'noise=alls=5:allf=t+u' ;;
        强) printf 'noise=alls=16:allf=t+u' ;;
        *)  printf 'noise=alls=10:allf=t+u' ;;
    esac
}

# ── 平滑断层/去色带（源自 3FUI 平滑断层滤镜）──────────
# 用法: fftools_deband <轻|中|强|gradfun>
fftools_deband() {
    case "${1:-中}" in
        轻)      printf 'deband=1thr=0.012:2thr=0.012:3thr=0.012:range=12:blur=1' ;;
        强)      printf 'deband=1thr=0.03:2thr=0.03:3thr=0.03:range=24:blur=1:coupling=1' ;;
        gradfun) printf 'gradfun=1.2:16' ;;
        *)       printf 'deband=1thr=0.02:2thr=0.02:3thr=0.02:range=16:blur=1' ;;
    esac
}

# ── 去隔行/反胶卷下拉（源自 3FUI 扫描方式滤镜）────────
# 用法: fftools_deinterlace <yadif|yadif_field|bwdif|ivtc>
fftools_deinterlace() {
    case "${1:-yadif}" in
        yadif_field) printf 'yadif=mode=send_field:parity=auto:deint=all' ;;
        bwdif)       printf 'bwdif=mode=send_frame:parity=auto:deint=all' ;;
        ivtc)        printf 'fieldmatch,yadif=deint=interlaced,decimate' ;;
        *)           printf 'yadif=mode=send_frame:parity=auto:deint=all' ;;
    esac
}

# ── 画面翻转/旋转（源自 3FUI 画面翻转滤镜）────────────
# 用法: fftools_transpose <顺时针|逆时针|180|水平|垂直>
fftools_transpose() {
    case "${1:-顺时针}" in
        逆时针) printf 'transpose=2' ;;
        180)    printf 'transpose=1,transpose=1' ;;
        水平)   printf 'hflip' ;;
        垂直)   printf 'vflip' ;;
        *)      printf 'transpose=1' ;;
    esac
}

# ── 抽帧：去掉重复/近似重复帧（源自 3FUI 抽帧滤镜）────
# 用法: fftools_mpdecimate <轻|强>
fftools_mpdecimate() {
    case "${1:-轻}" in
        强) printf 'mpdecimate=hi=6*12:lo=6*5:frac=0.33,setpts=N/FRAME_RATE/TB' ;;
        *)  printf 'mpdecimate,setpts=N/FRAME_RATE/TB' ;;
    esac
}

# ── 调色（亮度/对比度/饱和度/Gamma）──────────────────
# 用法: fftools_eq "亮度:对比度:饱和度:Gamma"（可缺省某段，如 "::1.1"）
fftools_eq() {
    local b c s g
    IFS=: read -r b c s g <<< "${1:-}"
    local out=""
    [[ -n "${b:-}" ]] && out+="brightness=$b:"
    [[ -n "${c:-}" ]] && out+="contrast=$c:"
    [[ -n "${s:-}" ]] && out+="saturation=$s:"
    [[ -n "${g:-}" ]] && out+="gamma=$g:"
    [[ -n "$out" ]] && printf '%s' "eq=${out%:}"
}

# ── 超分/高质量缩放（libplacebo，源自 3FUI 超分滤镜）──
# 用法: fftools_superres <宽:高> [缩放算法] [自定义shader路径]
# 缩放算法可选: ewa_lanczossharp ewa_lanczos4sharpest lanczos bicubic bilinear 等
fftools_superres() {
    local wh="$1" scaler="${2:-ewa_lanczossharp}" shader="${3:-}"
    local w="${wh%%:*}" h="${wh#*:}"
    local out="libplacebo=w=$w:h=$h:upscaler=$scaler:downscaler=none:antiringing=0.7"
    [[ -n "$shader" && -f "$shader" ]] && out+=":custom_shader_path=$(escape_subtitle_path "$shader")"
    printf '%s' "$out"
}

# ── 发现本地 VMAF 模型（源自 3FUI 质量评测模型选择）───
# 输出: 模型路径列表（系统目录与用户目录）
fftools_vmaf_models() {
    local -a dirs=(
        "/usr/share/model"
        "/usr/share/vmaf/models"
        "${XDG_DATA_HOME:-$HOME/.local/share}/vmaf-models"
    )
    local d
    for d in "${dirs[@]}"; do
