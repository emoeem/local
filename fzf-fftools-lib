#!/usr/bin/env bash
# fzf-fftools shared functions and picker definitions.

FZF_FFTOOLS_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
PVID="$FZF_FFTOOLS_DIR/fzf-preview-video"
[[ -x "$PVID" ]] || PVID="$(command -v fzf-preview-video 2>/dev/null || true)"
FFTOOLS_STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/fzf-fftools"
FFTOOLS_CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/fzf-media-preview"
FFTOOLS_FONT_CACHE="${XDG_CACHE_HOME:-$HOME/.cache}/fzf-fftools/fonts.tsv"

FZF_BASE=(
    --height 100%
    --preview-label-pos bottom
    --preview-window 'right:60%:nowrap:border-left'
    --bind 'ctrl-p:toggle-preview'
    --bind 'ctrl-w:toggle-preview-wrap'
    --bind 'ctrl-d:preview-half-page-down,ctrl-u:preview-half-page-up'
    --bind 'ctrl-up:preview-up,ctrl-down:preview-down'
    --color 'pointer:green,marker:green,header:cyan'
)

FZF_MULTI_BASE=(
    --multi
    --bind 'ctrl-a:select-all,ctrl-x:deselect-all'
)

open_yazi_media() {
    require_tools yazi || return 1
    yazi "${1:-.}"
}

ffmpeg() {
    command ffmpeg "$@"
}

require_tools() {
    local missing=() tool
    for tool in "$@"; do
        command -v "$tool" >/dev/null 2>&1 || missing+=("$tool")
    done
    if (( ${#missing[@]} > 0 )); then
        printf '缺少命令: %s\n' "${missing[*]}" >&2
        return 1
    fi
}

media_candidates() {
    local regex="$1"
    fd --type f --ignore-case "$regex" --hidden --follow \
        --exclude .git --exclude node_modules --exclude target --exclude .cache \
        --exclude batch_out . 2>/dev/null
}

pick_with_preview() {
    local header="$1"
    fzf "${FZF_BASE[@]}" --header "$header" --preview "$PVID {}"
}

pick_multi_with_preview() {
    local header="$1"
    fzf "${FZF_BASE[@]}" "${FZF_MULTI_BASE[@]}" --header "$header" \
        --preview "$PVID {}"
}

pick_video() {
    media_candidates '\.(mp4|mkv|mov|avi|webm|ts|m4v|flv|mpeg|mpg|wmv|3gp)$' |
        pick_with_preview '选择视频 · Ctrl-P 切换预览'
}

pick_videos() {
    media_candidates '\.(mp4|mkv|mov|avi|webm|ts|m4v|flv|mpeg|mpg|wmv|3gp)$' |
        pick_multi_with_preview '选择视频 · Tab 多选 · Ctrl-A 全选'
}

pick_image() {
    media_candidates '\.(jpg|jpeg|png|webp|bmp|gif|tiff|tif|avif|heic|heif|jxl|apng)$' |
        pick_with_preview '选择图片 · Ctrl-P 切换预览'
}

pick_visual() {
    media_candidates '\.(mp4|mkv|mov|avi|webm|ts|m4v|flv|mpeg|mpg|wmv|3gp|jpg|jpeg|png|webp|bmp|gif|tiff|tif|avif|heic|heif|jxl|apng)$' |
        pick_with_preview '选择图片或视频 · Ctrl-P 切换预览'
}

pick_audio() {
    media_candidates '\.(mp3|flac|wav|aac|m4a|opus|ogg|wma|ac3|aiff|ape)$' |
        pick_with_preview '选择音频 · 预览封面或波形'
}

pick_media() {
    media_candidates '\.(mp4|mkv|mov|avi|webm|ts|m4v|flv|mpeg|mpg|wmv|3gp|mp3|flac|wav|aac|m4a|opus|ogg|wma|ac3|aiff|ape|jpg|jpeg|png|webp|bmp|gif|tiff|tif|avif|heic|heif|jxl|apng)$' |
        pick_with_preview '浏览媒体 · 图片/视频帧/音频封面'
}

pick_files() {
    media_candidates '\.(mp4|mkv|mov|avi|webm|ts|m4v|flv|mpeg|mpg|wmv|3gp|jpg|jpeg|png|webp|bmp|gif|tiff|tif|avif)$' |
        pick_multi_with_preview '选择文件 · Tab 多选 · Ctrl-A 全选'
}

fftools_log() {
    mkdir -p -- "$FFTOOLS_STATE_DIR"
    printf '[%(%F %T)T] %s\n' -1 "$*" >> "$FFTOOLS_STATE_DIR/tasks.log"
}

fftools_confirm() {
    local prompt="${1:-执行上述任务？[Y/n]}"
    local default="${2:-yes}"
    local choice

    printf '\n%s ' "$prompt"
    read -r choice
    if [[ -z "$choice" ]]; then
        [[ "$default" == "yes" ]]
    else
        [[ "$choice" != [nN]* ]]
    fi
}

fftools_progress() {
    local current="$1" total="$2" label="${3:-}"
    local width=30 percent filled empty
    local complete_bar remaining_bar

    (( total > 0 )) || return 0
    percent=$((current * 100 / total))
    (( percent > 100 )) && percent=100
    filled=$((percent * width / 100))
    empty=$((width - filled))
    printf -v complete_bar '%*s' "$filled" ''
    printf -v remaining_bar '%*s' "$empty" ''
    complete_bar=${complete_bar// /#}
    remaining_bar=${remaining_bar// /-}
    printf '\r翻译 [%s%s] %3d%%  %d/%d  %s' \
        "$complete_bar" "$remaining_bar" "$percent" "$current" "$total" "$label"
    (( current >= total )) && printf '\n'
    return 0
}

fftools_run() {
    local log_path status
    mkdir -p -- "$FFTOOLS_STATE_DIR/logs"
    log_path="$FFTOOLS_STATE_DIR/logs/$(date +%Y%m%d-%H%M%S)-$$.log"
    printf '\n命令：'
    printf ' %q' "$@"
    printf '\n日志：%s\n\n' "$log_path"
    fftools_log "start: $(printf '%q ' "$@")"
    command "$@" 2>&1 | tee "$log_path"
    status=${PIPESTATUS[0]}
    fftools_log "finished($status): $log_path"
    return "$status"
}

fftools_output_path() {
    local input="$1" suffix="$2" extension="$3" output_dir="$4" force="$5"
    local stem candidate index=1
    stem=$(basename -- "${input%.*}")
    mkdir -p -- "$output_dir"
    candidate="$output_dir/${stem}${suffix}.${extension}"
    if [[ "$force" == true || ! -e "$candidate" ]]; then
        printf '%s\n' "$candidate"
        return
    fi
    while [[ -e "$output_dir/${stem}${suffix}-${index}.${extension}" ]]; do
        ((index++))
    done
    printf '%s\n' "$output_dir/${stem}${suffix}-${index}.${extension}"
}

fftools_doctor() {
    local tool encoder
    for tool in ffmpeg ffprobe fzf fd chafa; do
        if command -v "$tool" >/dev/null 2>&1; then
            printf '✓ %-8s %s\n' "$tool" "$(command -v "$tool")"
        else
            printf '✗ %-8s 未安装\n' "$tool"
        fi
    done
    printf '\n编码器：\n'
    for encoder in h264_nvenc hevc_nvenc av1_nvenc libx264 libx265 libsvtav1; do
        if ffmpeg -hide_banner -encoders 2>/dev/null | grep -q " $encoder"; then
            printf '✓ %s\n' "$encoder"
        else
            printf '· %s 不可用\n' "$encoder"
        fi
    done
    ffmpeg -hide_banner -filters 2>/dev/null | grep -q ' subtitles ' && printf '✓ libass 字幕滤镜\n' || printf '· libass 字幕滤镜不可用\n'
}

fftools_analyze() {
    ffprobe -v error -show_format -show_streams -of json -- "$1"
}

fftools_cache() {
    case "${1:-status}" in
        status) du -sh -- "$FFTOOLS_CACHE_DIR" 2>/dev/null || printf '缓存为空。\n' ;;
        clear) rm -rf -- "$FFTOOLS_CACHE_DIR"; printf '预览缓存已清理。\n' ;;
        prune) find "$FFTOOLS_CACHE_DIR" -type f -mtime +30 -delete 2>/dev/null; printf '已清理 30 天前的预览缓存。\n' ;;
        *) printf '用法: cache [status|clear|prune]\n' >&2; return 2 ;;
    esac
}

confirm_run_cmd() {
    printf '命令：'
    printf ' %q' "$@"
    printf '\n'
    fftools_confirm || return 0
    fftools_run "$@"
}

