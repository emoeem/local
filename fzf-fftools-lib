# ── 编码器高级选项（tune/无损，源自 3FUI 编码器数据库）─
# 输出到 stdout 的参数会被追加到编码参数之后；返回 1=用户取消
fftools_advanced_args() {
    local venc="$1" tune lossless
    case "$venc" in
        libx265|libx264|hevc_nvenc|av1_nvenc|h264_nvenc) ;;
        *) return 0 ;;
    esac
    local tunes=""
    case "$venc" in
        libx265) tunes="不设置 psnr ssim grain fastdecode zerolatency animation stillimage" ;;
        libx264) tunes="不设置 psnr ssim grain fastdecode zerolatency animation stillimage" ;;
        *nvenc)  tunes="不设置 hq ull ll lossless" ;;
    esac
    tune=$(printf '%s\n' $tunes | fzf "${FZF_BASE[@]}" --height 35% --header "tune 调优（回车=不设置）") || return 1
    [[ -z "$tune" || "$tune" == 不设置 ]] || printf '%s\n' "-tune" "$tune"
    lossless=$(printf '%s\n' '否' '是（真正无损，体积巨大）' \
        | fzf "${FZF_BASE[@]}" --height 25% --header '无损模式') || return 1
    case "$lossless" in
        是*) case "$venc" in
                 libx265) printf '%s\n' "-x265-params" "lossless=1" ;;
                 libx264) printf '%s\n' "-qp" "0" ;;
                 *nvenc)  printf '%s\n' "-tune" "lossless" ;;
             esac ;;
    esac
    return 0
}

# ── 编码器默认参数（源自 3FUI 数据库）────────────────
# 用法: encoder_default <编码器> <preset|quality> → 输出 "参数名 默认值"
encoder_default() {
    local enc="$1" kind="$2" item flag range default
    local -n list
    [[ "$kind" == preset ]] && list=PSMAP || list=QMAP
    for item in "${list[@]}"; do
        if [[ "$item" == "$enc:"* ]]; then
            IFS=: read -r _ flag range default <<< "$item"
            printf '%s %s\n' "$flag" "$default"
            return 0
        fi
    done
    return 1
}

# ── 批量编码器选择菜单（源自 3FUI 数据库）────────────
# 用法: venc=$(fftools_pick_encoder) || exit 0
fftools_pick_encoder() {
    local encoder_menu=() item enc d
    local -a unavailable=()
    local encoders_list
    encoders_list=$(ffmpeg -hide_banner -encoders 2>/dev/null)
    for item in "${QMAP[@]}"; do
        enc="${item%%:*}"
        case "$enc" in
            libx265)     d="软件 H.265 · 体积小、画质好" ;;
            libx264)     d="软件 H.264 · 兼容最好" ;;
            libsvtav1)   d="软件 AV1 · 快且省体积" ;;
            libaom-av1)  d="软件 AV1 · 最省体积、极慢" ;;
            librav1e)    d="软件 AV1 · rav1e" ;;
            libsvt_hevc) d="软件 H.265 · SVT 引擎" ;;
            libvpx-vp9)  d="软件 VP9 · 网页友好" ;;
            libvvenc)    d="软件 H.266/VVC · 下一代编码" ;;
            libvpx)      d="软件 VP8 · 老旧网页格式" ;;
            ffv1)        d="FFv1 · 归档无损" ;;
            av1_nvenc)   d="N卡硬件 AV1 · 快" ;;
            hevc_nvenc)  d="N卡硬件 H.265 · 快" ;;
            h264_nvenc)  d="N卡硬件 H.264 · 快" ;;
            av1_qsv)     d="Intel 硬件 AV1 · 快" ;;
            hevc_qsv)    d="Intel 硬件 H.265 · 快" ;;
            h264_qsv)    d="Intel 硬件 H.264 · 快" ;;
            av1_vulkan)  d="Vulkan 硬件 AV1" ;;
            hevc_vulkan) d="Vulkan 硬件 H.265" ;;
            h264_vulkan) d="Vulkan 硬件 H.264" ;;
            *) continue ;;
        esac
        # 本机 ffmpeg 未编译的编码器不进菜单，避免选了必失败
        if ! grep -q " $enc " <<< "$encoders_list"; then
            unavailable+=("$enc")
            continue
        fi
        encoder_menu+=("$enc|$d")
    done
    (( ${#unavailable[@]} > 0 )) && printf '本机未编译，已从菜单隐藏: %s\n' "${unavailable[*]}" >&2
    printf '%s\n' "${encoder_menu[@]}" \
        | fzf "${FZF_BASE[@]}" --height 40% --delimiter='|' --with-nth=2 --header '选择编码方式' \
        | cut -d'|' -f1
}

# ── 编码器默认参数（写入全局 ENCODE_ARGS / PIX_VALUE）──
# 用法: fftools_encoder_setup <编码器>
fftools_encoder_setup() {
    local venc="$1" pflag="" preset_default="" qflag="" quality_default="" info pix
    ENCODE_ARGS=()
    PIX_VALUE=""
    if info=$(encoder_default "$venc" preset); then
        read -r pflag preset_default <<< "$info"
    fi
    if info=$(encoder_default "$venc" quality); then
        read -r qflag quality_default <<< "$info"
    fi
    [[ -n "$pflag" && -n "$preset_default" ]] && ENCODE_ARGS+=("$pflag" "$preset_default")
    [[ -n "$qflag" && -n "$quality_default" ]] && ENCODE_ARGS+=("$qflag" "$quality_default")
    pix=$(pix_fmt "$venc")
    [[ -n "$pix" ]] && PIX_VALUE="${pix#-pix_fmt }"
}

# ── 解析 HH:MM:SS(.xx) 为秒 ───────────────────────────
fftools_parse_time() {
    local hms="$1" h m s
    IFS=: read -r h m s <<< "$hms"
    awk -v h="${h:-0}" -v m="${m:-0}" -v s="${s:-0}" \
        'BEGIN { printf "%.1f", h*3600+m*60+s }'
}

# ── 运行命令并实时显示 ffmpeg 进度/速度/码率 ─────────
# 用法: fftools_run_live <命令...>（自动探测第一个 -i 输入的时长）
fftools_run_live() {
    local cmd=("$@") input="" duration="" status log_path
    local prev=""
    for arg in "${cmd[@]}"; do
        if [[ "$prev" == "-i" ]]; then
            input="$arg"
            break
        fi
        prev="$arg"
    done
    if [[ -n "$input" && -f "$input" ]]; then
        duration=$(ffprobe -v error -show_entries format=duration \
            -of default=noprint_wrappers=1:nokey=1 -- "$input" 2>/dev/null | head -1)
    fi

    mkdir -p -- "$FFTOOLS_STATE_DIR/logs"
    log_path="$FFTOOLS_STATE_DIR/logs/$(date +%Y%m%d-%H%M%S)-$$.log"
    printf '\n命令：'
    printf ' %q' "${cmd[@]}"
    printf '\n日志：%s\n\n' "$log_path"
    fftools_log "start: $(printf '%q ' "${cmd[@]}")"

    local tty=0
    [[ -t 1 ]] && tty=1
    command "${cmd[@]}" 2>&1 | tee "$log_path" | while IFS= read -r line; do
        [[ "$line" == *"frame="* ]] || continue
        local time_str speed fps bitrate size frame sec pct
        time_str=$(grep -o 'time=[0-9:.+-]*' <<< "$line" | head -1 | cut -d= -f2)
        speed=$(grep -o 'speed=[0-9.]*x' <<< "$line" | head -1 | cut -d= -f2)
        fps=$(grep -o 'fps=[0-9.]*' <<< "$line" | head -1 | cut -d= -f2)
        bitrate=$(grep -o 'bitrate=[0-9.]*kbits/s' <<< "$line" | head -1 | cut -d= -f2)
        size=$(grep -o 'size=[0-9.]*kB' <<< "$line" | head -1 | cut -d= -f2)
        frame=$(grep -o 'frame=[0-9]*' <<< "$line" | head -1 | cut -d= -f2)
        sec=""
        [[ -n "$time_str" ]] && sec=$(fftools_parse_time "$time_str")
        pct=""
        if [[ -n "$duration" && -n "$sec" && "$duration" =~ ^[0-9]+([.][0-9]+)?$ ]]; then
            pct=$(awk -v d="$duration" -v s="$sec" \
                'BEGIN { p=s*100/d; if (p>100) p=100; printf "%d", p }')
        fi
        if (( tty )); then
            printf '\r'
            if [[ -n "$pct" ]]; then
                local filled=$((pct * 20 / 100)) empty=$((20 - filled)) bar rest
                printf -v bar '%*s' "$filled" ''
                printf -v rest '%*s' "$empty" ''
                bar=${bar// /#}
                rest=${rest// /-}
                printf '[%s%s] %3d%%' "$bar" "$rest" "$pct"
            fi
            [[ -n "$time_str" ]] && printf ' %s' "$time_str"
            [[ -n "$speed" ]] && printf ' 速度%s' "$speed"
            [[ -n "$fps" ]] && printf ' %sfps' "$fps"
            [[ -n "$bitrate" ]] && printf ' 码率%sk' "$bitrate"
            printf ' '
        fi
    done
    status=${PIPESTATUS[0]}
    (( tty )) && printf '\n'
    fftools_log "finished($status): $log_path"
    return "$status"
}

# ── 编码器二次编码支持（源自 FFmpegFreeUI 数据库）──────
encoder_supports_2pass() {
    case "$1" in
        libx264|libx265|libsvtav1|libaom-av1|libvpx-vp9|libsvt_hevc|librav1e|libvvenc|libvpx) return 0 ;;
        *) return 1 ;;
    esac
}

# 二次编码：pass1 分析 → pass2 输出（需码率控制参数如 -b:v）
# 用法: encode_2pass <输入> <输出> [额外视频/音频参数...]
encode_2pass() {
    local input="$1" output="$2" logbase
    local -a extra=("${@:3}")
    logbase="${output%.*}_passlog"
    fftools_run ffmpeg -y -i "$input" "${extra[@]}" \
        -pass 1 -passlogfile "$logbase" -an -f null /dev/null || return 1
    fftools_run ffmpeg -y -i "$input" "${extra[@]}" \
        -pass 2 -passlogfile "$logbase" "$output"
}

# ── 自动检测电池路径 ───────────────────────────────────
detect_battery() {
    for bat in /sys/class/power_supply/BAT{0,1,2}; do
        [[ -f "$bat/capacity" ]] && echo "$bat" && return 0
    done
    return 1
}

