#!/usr/bin/env bash
# fzf-compress-video:summary=Compress/resize video with CRF, scale, audio normalization and hw accel via fzf.
set -euo pipefail

script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
source "$script_dir/fzf-fftools-lib"

require_tools ffmpeg ffprobe || exit 1

if [[ $# -gt 0 ]]; then
    video="$1"
else
    require_tools fzf fd || exit 1
    video=$(pick_video) || exit 0
    [[ -z "$video" ]] && exit 0
fi

# HDR 检测
if detect_hdr "$video"; then
    printf '⚠️  检测到 HDR 视频，建议使用 H.265 (libx265) + 10-bit 输出以保留动态范围。\n'
fi

# 编码器
encoder=$(printf 'H.264 (兼容性最好, 推荐)\nH.265/HEVC (体积更小, HDR友好)\n' \
    | fzf "${FZF_BASE[@]}" --height 30% --header '选择编码器') || exit 0
case "${encoder%% *}" in
    H.265*) venc="libx265"; pix_fmt_name="yuv420p10le" ;;
    *)      venc="libx264"; pix_fmt_name="yuv420p" ;;
esac

# 硬件加速（解码+编码一起切到硬件；无对应编码器时保持软件编码）
hw=$(hw_accel_auto)
hw_args=()
if [[ -n "$hw" ]]; then
    use_hw=$(printf "使用硬件加速 ($hw)\n使用软件编码" \
        | fzf "${FZF_BASE[@]}" --height 25% --header '硬件加速') || true
    if [[ "$use_hw" == 使用* ]]; then
        hw_args=(-hwaccel "$hw")
        nvenc=""
        case "$venc" in
            libx264) ffmpeg -hide_banner -encoders 2>/dev/null | grep -q ' h264_nvenc ' && nvenc=h264_nvenc ;;
            libx265) ffmpeg -hide_banner -encoders 2>/dev/null | grep -q ' hevc_nvenc ' && nvenc=hevc_nvenc ;;
        esac
        if [[ -n "$nvenc" ]]; then
            venc="$nvenc"
            if [[ "$nvenc" == hevc_nvenc ]]; then
                pix_fmt_name="p010le"
            else
                pix_fmt_name="yuv420p"
            fi
        else
            printf 'ℹ️ 未检测到 NVENC，硬件加速仅用于解码，编码仍为软件\n'
        fi
    fi
fi

# CRF
crf=$(printf '23 (推荐, 高质量)\n28 (中等压缩)\n32 (高压缩, 体积小)\n18 (近乎无损, 体积大)' \
    | fzf "${FZF_BASE[@]}" --height 30% --header '压缩质量 (CRF, 越小质量越高)') || exit 0
crf_val=$(echo "$crf" | grep -oP '\d+')

# 分辨率
scale=$(printf '保持原始\n1080p (1920x1080)\n720p (1280x720)\n480p (854x480)' \
    | fzf "${FZF_BASE[@]}" --height 30% --header '输出分辨率') || exit 0
case "${scale%% *}" in
    1080p) vf_filter="scale=-2:1080" ;;
    720p)  vf_filter="scale=-2:720" ;;
    480p)  vf_filter="scale=-2:480" ;;
    *)     vf_filter="" ;;
esac

# 音频标准化
norm=$(printf '保持原始音频\n标准化音量 (EBU R128)' \
    | fzf "${FZF_BASE[@]}" --height 25% --header '音频处理') || exit 0
af_args=()
[[ "$norm" == 标准化* ]] && af_args=(-af "$(loudnorm_filter)")

output="${video%.*}_compressed.mp4"
read -r -p "输出 [$output]: " custom || true
output="${custom:-$output}"
if [[ "$(realpath -m -- "$output")" == "$(realpath -m -- "$video")" ]]; then
    output="${video%.*}_compressed.mp4"
    printf '⚠️  输出与输入相同，已改为: %s\n' "$output"
fi

# 构建命令（nvenc 用 -cq，软编用 -crf）
if [[ "$venc" == *_nvenc ]]; then
    qargs=(-cq "$crf_val")
else
    qargs=(-crf "$crf_val")
fi
cmd_args=("${hw_args[@]}" -i "$video" -c:v "$venc" "${qargs[@]}" -preset medium -pix_fmt "$pix_fmt_name" -c:a aac -b:a 128k)
[[ -n "$vf_filter" ]] && cmd_args+=(-vf "$vf_filter")
cmd_args+=("${af_args[@]}")
cmd_args+=(-y "$output")

fftools_run ffmpeg "${cmd_args[@]}"
