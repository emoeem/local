#!/usr/bin/env bash
# fzf-compress-video:summary=压缩视频体积：可调画质、分辨率、音量，还能用硬件加速。
set -euo pipefail

script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
source "$script_dir/fzf-fftools-lib"

require_tools ffmpeg ffprobe || exit 1

video=$(fftools_input_video "$@") || exit 0
[[ -z "$video" ]] && exit 0

# HDR 检测
if detect_hdr "$video"; then
    printf '⚠️  检测到 HDR 视频，建议使用 H.265 (libx265) + 10-bit 输出以保留动态范围。\n'
fi

# 编码器
encoder=$(printf 'H.264 (兼容性最好, 推荐)\nH.265/HEVC (体积更小, HDR友好)\n' \
    | fzf "${FZF_BASE[@]}" --height 30% --header '选择编码器') || exit 0
case "${encoder%% *}" in
    H.265*) venc="libx265"; pix_fmt_name="yuv420p10le" ;;
    *)      venc="libx264"; pix_fmt_name="yuv420p" ;;
esac

# 硬件加速（解码+编码一起切到硬件；无对应编码器时保持软件编码）
hw=$(fftools_choose_hwaccel) || true
hw_args=()
if [[ -n "$hw" ]]; then
    hw_args=(-hwaccel "$hw")
    nvenc=$(fftools_nvenc_of "$venc" || true)
    if [[ -n "$nvenc" ]]; then
        venc="$nvenc"
        if [[ "$nvenc" == hevc_nvenc || "$nvenc" == av1_nvenc ]]; then
            pix_fmt_name="p010le"
        else
            pix_fmt_name="yuv420p"
        fi
    else
        printf 'ℹ️ 未检测到对应硬件编码器，硬件加速仅用于解码，编码仍为软件\n'
    fi
fi

# CRF
crf=$(printf '23 (推荐, 高质量)\n28 (中等压缩)\n32 (高压缩, 体积小)\n18 (近乎无损, 体积大)' \
    | fzf "${FZF_BASE[@]}" --height 30% --header '压缩质量 (CRF, 越小质量越高)') || exit 0
crf_val=$(fftools_first_number "$crf")

# 分辨率
scale=$(printf '保持原始\n1080p (1920x1080)\n720p (1280x720)\n480p (854x480)' \
    | fzf "${FZF_BASE[@]}" --height 30% --header '输出分辨率') || exit 0
case "${scale%% *}" in
    1080p) vf_filter="scale=-2:1080" ;;
    720p)  vf_filter="scale=-2:720" ;;
    480p)  vf_filter="scale=-2:480" ;;
    *)     vf_filter="" ;;
esac

# 画面增强滤镜（接入 lib 新滤镜，源自 3FUI）
enhance=$(printf '%s\n' '不增强' '降噪 hqdn3d (中)' '去色带 deband (中)' '锐化 unsharp (中)' '2x 超分 (libplacebo)' \
    | fzf "${FZF_BASE[@]}" --height 35% --header '画面增强') || exit 0
enhance_vf=""
case "$enhance" in
    降噪*)     enhance_vf=$(fftools_denoise hqdn3d 中) ;;
    去色带*)   enhance_vf=$(fftools_deband 中) ;;
    锐化*)     enhance_vf=$(fftools_sharpen unsharp 中) ;;
    2x*)       enhance_vf=$(fftools_superres 'iw*2:ih*2' ewa_lanczossharp) ;;
esac

# 音频标准化
norm=$(printf '保持原始音频\n标准化音量 (EBU R128)' \
    | fzf "${FZF_BASE[@]}" --height 25% --header '音频处理') || exit 0
af_args=()
[[ "$norm" == 标准化* ]] && af_args=(-af "$(loudnorm_filter)")

output=$(fftools_output_prompt "$video" "${video%.*}_compressed.mp4")

# 构建命令（nvenc 用 -cq，软编用 -crf）
if [[ "$venc" == *_nvenc ]]; then
    qargs=(-cq "$crf_val")
else
    qargs=(-crf "$crf_val")
fi
cmd_args=("${hw_args[@]}" -i "$video" -c:v "$venc" "${qargs[@]}" -preset medium -pix_fmt "$pix_fmt_name" -c:a aac -b:a 128k)
# 滤镜顺序: 缩放在前、增强在后;超分时先超分再缩放反而失真,故统一 缩放→增强
vf_chain="$vf_filter"
[[ -n "$enhance_vf" ]] && vf_chain="${vf_chain:+$vf_chain,}$enhance_vf"
[[ -n "$vf_chain" ]] && cmd_args+=(-vf "$vf_chain")
cmd_args+=("${af_args[@]}")
cmd_args+=(-y "$output")

fftools_run ffmpeg "${cmd_args[@]}"
