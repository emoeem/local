#!/usr/bin/env bash
# fzf-subtitles:summary=字幕工具：从视频抽取、封装外部字幕、烧录进画面。
set -euo pipefail

script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
source "$script_dir/fzf-fftools-lib"

require_tools ffmpeg || exit 1

force=false
output_dir=.
while [[ $# -gt 0 ]]; do
    case "$1" in
        --force) force=true ;;
        --output-dir)
            [[ $# -ge 2 ]] || { printf '用法: fzf-subtitles [--force] [--output-dir DIR] [视频文件...]\n' >&2; exit 2; }
            output_dir="$2"; shift ;;
        -h|--help) printf '用法: fzf-subtitles [--force] [--output-dir DIR] [视频文件...]\n'; exit ;;
        *) break ;;
    esac
    shift
done

mapfile -t videos < <(if (( $# )); then printf '%s\n' "$@"; else media_candidates '\.(mp4|mkv|mov|webm|avi|m4v)$' | fzf "${FZF_BASE[@]}" "${FZF_MULTI_BASE[@]}" --header '选择视频 · Ctrl-A 全选 · Ctrl-X 取消全选' --preview "$PVID {}"; fi)
(( ${#videos[@]} )) || exit 0
overwrite=(-n)
[[ "$force" == true ]] && overwrite=(-y)

operation=$(printf '%s\n' 'extract  抽取第一条字幕' 'mux      无损封装外部字幕' 'burn     烧录外部字幕' | fzf "${FZF_BASE[@]}" --height 30% --header '字幕操作') || exit 0
operation=${operation%% *}

case "$operation" in
    extract)
        ok=0; fail=0
        for video in "${videos[@]}"; do
            output=$(fftools_output_path "$video" '_subtitle' srt "$output_dir" "$force")
            fftools_confirm || continue
            if fftools_run ffmpeg "${overwrite[@]}" -i "$video" -map 0:s:0 -c:s srt "$output"; then
                ((++ok))
            else
                ((++fail))
                printf '✗ 无字幕轨或提取失败: %s\n' "$video" >&2
            fi
        done
        printf '完成: 成功 %d, 失败 %d\n' "$ok" "$fail"
        ;;
    mux|burn)
        sub_list=""
        sub_list=$(fd --type f --extension srt --extension ass --extension vtt . 2>/dev/null) || true
        [[ -n "$sub_list" ]] || { echo "当前目录树下没有字幕文件 (srt/ass/vtt)" >&2; exit 0; }
        subtitle=$(printf '%s\n' "$sub_list" | fzf "${FZF_BASE[@]}" --header '选择字幕文件' --preview "$PVID {}") || exit 0
        ok=0; fail=0
        for video in "${videos[@]}"; do
            extension=${video##*.}
            output=$(fftools_output_path "$video" "_${operation}" "$extension" "$output_dir" "$force")
            status=0
            if [[ "$operation" == mux ]]; then
                # 字幕编码器按输出容器选择：mp4/mov 用 mov_text，webm 用 webvtt，其余容器用 srt
                case "${extension,,}" in
                    mp4|mov|m4v) sub_codec=mov_text ;;
                    webm)        sub_codec=webvtt ;;
                    *)           sub_codec=srt ;;
                esac
                fftools_run ffmpeg "${overwrite[@]}" -i "$video" -i "$subtitle" -map 0 -map 1:0 -c copy -c:s "$sub_codec" -metadata:s:s:0 language=und "$output" || status=$?
            else
                subtitle_filter=$(subtitle_filter "$subtitle")
                fftools_run ffmpeg "${overwrite[@]}" -i "$video" -vf "$subtitle_filter" -c:v libx264 -c:a copy "$output" || status=$?
            fi
            if (( status == 0 )); then
                ((++ok))
            else
                ((++fail))
                printf '✗ 失败(%d): %s\n' "$status" "$video" >&2
            fi
        done
        printf '完成: 成功 %d, 失败 %d\n' "$ok" "$fail"
        ;;
esac
